# Local Supabase CLI development only. Copy to supabase/functions/.env (gitignored).
# Never commit real values, service-role keys, or provider secrets.
CLEANUP_WEBHOOK_SECRET=

# 100ms server-only settings. Fill these only in Supabase Edge Functions Secrets.
HMS_ACCESS_KEY=
HMS_APP_SECRET=
HMS_TEMPLATE_ID=
HMS_WEBHOOK_SECRET=
HMS_HOST_ROLE_NAME=
HMS_MEMBER_ROLE_NAME=
# Explicit declarations confirmed after configuring the 100ms template.
HMS_RECORDING_ENABLED=
HMS_STORAGE_CONFIGURED=
HMS_REGION=

# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase Edge Functions at runtime. Never copy the service-role key into this file,
# GitHub Pages, VITE_* variables, or the repository.
