# Local Supabase CLI development only. Copy to supabase/functions/.env (gitignored).
# Required only by cleanup-verification-files for authenticated Database Webhook calls.
CLEANUP_WEBHOOK_SECRET=replace-with-a-long-random-value

# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase Edge Functions at runtime. Never copy the service-role key into this file,
# GitHub Pages, VITE_ variables, or the repository.
