# انسخ هذا الملف إلى .env.local للتطوير المحلي بعد إنشاء مشروع Supabase.
# Vite يضم متغيرات VITE_* داخل ملفات المتصفح؛ لا تضع فيها أي سر إداري.
# للإنتاج: أضف القيمتين إلى GitHub Actions → Variables بالاسمين أدناه حرفياً.

# العنوان العام الأساسي: استخدم رابط GitHub Pages الحالي؛ تغيير هذا المتغير لاحقاً
# إلى https://your-domain.example/ يعيد بناء الروابط وcanonical وsitemap وOG.
VITE_SITE_URL=https://proexcellencenetwork-art.github.io/mojtama-al-saytara/

# عنوان المشروع: Supabase Dashboard → Project Settings → API → Project URL.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# المفتاح العام anon القديم أو publishable الجديد؛ يخضع دائماً لسياسات RLS.
# لا تستخدم service_role أو secret key هنا مطلقاً.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# اختياري: مفتاح Turnstile العام فقط؛ المفتاح السري يوضع في إعدادات CAPTCHA داخل Supabase Auth.
# أضفه إلى GitHub Actions → Variables بعد إنشاء Widget في Cloudflare.
VITE_TURNSTILE_SITE_KEY=

# Google OAuth مؤجل افتراضياً. بعد إعداد Google Cloud وSupabase يمكن تغييره إلى true
# في GitHub Actions → Variables (أو .env.local للاختبار المحلي) ثم إعادة النشر.
VITE_GOOGLE_AUTH_ENABLED=false

# التسجيل العام مغلق افتراضياً. افتحه فقط بعد اكتمال UAT، وبالتوازي مع Supabase Auth.
VITE_PUBLIC_SIGNUP_ENABLED=false
