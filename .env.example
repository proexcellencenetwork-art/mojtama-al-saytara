# انسخ هذا الملف إلى .env.local بعد إنشاء مشروع Supabase.
# استخدم Project URL و anon/publishable key فقط في الواجهة.
# لا تضع service_role key أو كلمة مرور قاعدة البيانات في أي متغير VITE_.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
